# Copy this file to .env and fill in real values.

# ─── Server ─────────────────────────────────────────────
PORT=3000
API_KEY=change-me-to-a-long-random-string

# ─── OpenAI ─────────────────────────────────────────────
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini

# ─── Postgres ───────────────────────────────────────────
DATABASE_URL=postgres://app:app@db:5432/automation

# ─── Gmail ──────────────────────────────────────────────
GMAIL_CREDENTIALS=credentials.json
GMAIL_TOKEN=token.json

# ─── Gmail label IDs (real IDs printed by scripts/gmail-auth.js) ───
LABEL_URGENT=Label_1
LABEL_NEWSLETTER=Label_2
LABEL_INVOICE=Label_3
LABEL_OTHER=Label_4